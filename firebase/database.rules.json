{
  "rules": {
    ".read": false,
    ".write": false,
    "challenges": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.uid",
        ".validate": "newData.hasChildren(['status', 'endsAt', 'createdBy']) && $code.matches(/^[A-Z0-9]{6}$/)",
        "status": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists() && data.val() !== 'ended'",
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'active' || newData.val() === 'ended')"
        },
        "endsAt": { ".validate": "newData.isNumber()" },
        "createdBy": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && now < data.parent().parent().child('endsAt').val() + 120000",
            ".validate": "newData.hasChildren(['name', 'reels', 'seconds'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "reels": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000" },
            "seconds": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400" },
            "endVote": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
